# ===================== 基础架构配置 (N5105 + VMware x86_64) =====================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="Generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"
# N5105 多核优化（4核8线程适配）
CONFIG_KERNEL_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_KERNEL_SCHED_MC=y
CONFIG_KERNEL_SCHED_SMT=y



# ===================== 固件格式 (VMware 专属优化) =====================
CONFIG_TARGET_IMAGES_GZIP=y          # 通用压缩镜像
CONFIG_TARGET_IMAGES_VMDK=y          # VMware 原生 VMDK 格式（优先）
CONFIG_TARGET_IMAGES_ISO=y           # ISO 镜像（物理机/VMware 安装）
CONFIG_TARGET_IMAGES_VHDX=y          # 备用 Hyper-V 格式
CONFIG_TARGET_ROOTFS_PARTSIZE=2048   # 根分区 2048MB（适配 N5105 大存储）
CONFIG_TARGET_EXT4_BLOCKSIZE=4096
# VMware 虚拟化驱动
CONFIG_PACKAGE_kmod-vmxnet3=y        # VMware 高性能网卡驱动
CONFIG_PACKAGE_kmod-virtio=y         # VirtIO 驱动（VMware 存储/网卡）
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-net=y

# ===================== 内核配置 (N5105 硬件适配) =====================
CONFIG_KERNEL_BUILD_USER="N5105-ImmortalWRT"
CONFIG_KERNEL_BUILD_DOMAIN="github.com"
CONFIG_KERNEL_IPV6=y                 # 启用 IPv6（N5105 网络适配）
CONFIG_KERNEL_NET_CLS_CGROUP=y       # 流量控制
CONFIG_KERNEL_CGROUP_BPF=y           # OpenClash 依赖
CONFIG_KERNEL_NAMESPACES=y           # 容器/Clash 支持
CONFIG_KERNEL_OVERLAY_FS=y           # 叠加文件系统
CONFIG_KERNEL_SQUASHFS=y             # 固件压缩
# N5105 网卡/存储优化
CONFIG_KERNEL_NET_DEVLINK=y
CONFIG_KERNEL_SCSI_VIRTIO=y
CONFIG_KERNEL_USB_XHCI_HCD=y         # N5105 USB 3.0 驱动

# ===================== 基础系统组件 =====================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_7z=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y                # N5105 性能监控
CONFIG_PACKAGE_tree=y
CONFIG_PACKAGE_procps-ng=y

# ===================== 核心插件 (你指定的功能) =====================
# 1. OpenClash (完整依赖 + N5105 优化)
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_openclash=y
CONFIG_PACKAGE_clash=y
CONFIG_PACKAGE_glib2=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_rclone=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_iptables-mod-tproxy=y # 透明代理核心
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_ipset=y

# 2. WOL (网络唤醒 - N5105 远程开机)
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_wol=y
CONFIG_PACKAGE_etherwake=y           # WOL 底层工具

# 3. Samba4 (文件共享 - N5105 存储适配)
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_samba4-client=y
# Samba 性能优化（N5105 千兆网适配）
CONFIG_SAMBA4_MAX_DEBUG_LEVEL=1
CONFIG_SAMBA4_SERVER_NETBIOS=y

# 4. ipsec-vpnd (IPSec VPN 服务)
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_libipsec=y
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-ipsec=y
CONFIG_PACKAGE_strongswan-mod-aes=y
CONFIG_PACKAGE_strongswan-mod-sha1=y
CONFIG_PACKAGE_strongswan-mod-x509=y

# 5. onliner (在线用户监控)
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_onliner=y
CONFIG_PACKAGE_iputils-arping=y      # onliner 依赖

# ===================== 网络基础组件 =====================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y         # ImmortalWRT 兼容层
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-argon=y    # Argon 主题
CONFIG_PACKAGE_luci-app-argon-config=n
# 防火墙/网络
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_tcpdump=y             # 网络调试
CONFIG_PACKAGE_iproute2=y

# ===================== N5105 存储适配 =====================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y       # ImmortalWRT 原生 NTFS3
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb3=y           # N5105 USB 3.0 支持

# ===================== 性能优化 (N5105 专属) =====================
CONFIG_PACKAGE_irqbalance=y          # 多核中断均衡
CONFIG_PACKAGE_zram-swap=y           # 内存优化（N5105 8G内存适配）
CONFIG_PACKAGE_sysctl=y
CONFIG_PACKAGE_ethtool=y             # 网卡调优

# ===================== 移除不必要组件 (减小固件体积) =====================
CONFIG_PACKAGE_luci-theme-bootstrap=n
CONFIG_PACKAGE_ppp-mod-pptp=n
CONFIG_PACKAGE_ppp-mod-l2tp=n
CONFIG_PACKAGE_ipv6helper=n
CONFIG_PACKAGE_luci-app-frps=n       # 非必需插件移除
CONFIG_PACKAGE_luci-app-frpc=n
